{
  "name": "introverted-love",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "predev": "tsx scripts/migrate.ts",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p apps/web --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "preseed": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "report:events": "node scripts/dev-call.mjs report",
    "dev:plan": "node scripts/dev-call.mjs plan",
    "admin:report": "tsx scripts/admin.ts report",
    "admin:plan": "tsx scripts/admin.ts plan"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
