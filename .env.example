# Copy to .env.local. With these defaults the app runs with no accounts:
# dev login (alice/bob) and the fake AI coach.
DEV_AUTH=1

# Real sign-up: Clerk development keys (leave empty to skip Clerk entirely in dev)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Real AI: set a key and the coach switches to Anthropic automatically (or force with COACH)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
COACH=

# Empty = embedded PGlite under ./.data. Production: a transaction-mode pooler URL.
DATABASE_URL=

# Required in production: at least 32 random bytes
PREVIEW_TOKEN_SECRET=
UNDO_WINDOW_SECONDS=10

# M2
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
